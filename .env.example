# Copy to .env and fill in. .env is gitignored; never commit it or paste it in chat.
# Real environment variables (e.g. on the host) override .env.

# Elasticsearch (Elastic Cloud serverless): endpoint URL and the *Encoded* API key
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Index prefix; load tests and CI use rr_test_ so they never touch demo data
ES_INDEX_PREFIX=rr_

# Dash0: OTLP endpoint (4317 = gRPC, 4318 = HTTP) and auth token.
# src/telemetry-env.js maps these to the OTEL_EXPORTER_OTLP_* variables.
DASH0_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317
DASH0_TOKEN=

# Dash0 browser monitoring (optional; off when empty). Make a SEPARATE auth token in Dash0 with only the
# "Ingesting" permission, limited to one dataset: browsers must be handed it, so anyone can read it. Never reuse DASH0_TOKEN.
# The endpoint defaults to the host of DASH0_OTLP_ENDPOINT over HTTPS (no port); set DASH0_BROWSER_ENDPOINT to override.
DASH0_BROWSER_TOKEN=
DASH0_BROWSER_ENDPOINT=

PORT=3000

# Mock API (optional). Demo password, comma-separated staff/organiser usernames, cookie signing secret.
DEMO_PASSWORD=
# Resets the 'organiser' login's password on every boot (8+ characters). For when nobody knows it; remove after.
ORGANISER_PASSWORD=
STAFF=
ORGANISERS=
SESSION_SECRET=

# Address printed into the QR codes at /staff/qr (e.g. https://pantheon.cnh.radarhq.io, or http://<your LAN IP>:3000 locally).
# Empty: the address the page was opened on.
PUBLIC_URL=
