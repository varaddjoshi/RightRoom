# Copy to .env and fill in. .env is gitignored; never commit it or paste it in chat.
# Real environment variables (e.g. on the host) override .env.

# Elasticsearch (Elastic Cloud serverless): endpoint URL and the *Encoded* API key
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Index prefix; load tests and CI use rr_test_ so they never touch demo data
ES_INDEX_PREFIX=rr_

# Dash0: OTLP endpoint (4317 = gRPC, 4318 = HTTP) and auth token.
# src/telemetry-env.js maps these to the OTEL_EXPORTER_OTLP_* variables.
DASH0_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317
DASH0_TOKEN=

PORT=3000
