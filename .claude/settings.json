{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/swarmchat-inbox.sh\" start",
            "timeout": 20,
            "statusMessage": "Checking SwarmChat..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/swarmchat-inbox.sh\" prompt",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
